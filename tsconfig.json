{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/application/bootstrap.js",
    "src/application/debug-test-bridge.js",
    "tests/domain/**/*.ts",
    "tests/property/**/*.ts",
    "tests/data/p04b-schema.test.ts",
    "tests/data/durable-conformance-fixture.ts",
    "tests/data/browser-conformance-entry.ts",
    "tests/data/browser-vitest-shim.ts",
    "tests/data/p04b-page-api.ts",
    "vitest.config.ts"
  ]
}
